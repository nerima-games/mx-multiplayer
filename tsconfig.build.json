{
  // Shipped source only. `types: []` (inherited) is deliberate: if a Node type
  // ever leaks into domain code this project fails, which is what keeps
  // mc-kernel usable from browser, worker and server repos alike.
  "extends": "./tsconfig.base.json",
  "include": ["index.ts", "domain/**/*.ts"],
  "exclude": [
    "node_modules",
    "coverage",
    "dist",
    "test/**",
    "scripts/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
