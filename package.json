{
  "name": "@nerima-games/mx-multiplayer",
  "version": "0.1.4",
  "type": "module",
  "description": "Network synchronisation for the nerima-games Minecraft-clone rebuild: wire protocol, frame codec, connection state machine, snapshot interpolation and the transport Port. Multiplayer screens belong to mx-ui.",
  "homepage": "https://github.com/nerima-games/mx-multiplayer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mx-multiplayer.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mx-multiplayer/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "tsconfig.base.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "multiplayer",
    "protocol"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false",
    "lint": "oxlint --deny-warnings src scripts test apps",
    "lint:fix": "oxlint --fix src scripts test apps",
    "preview": "tsx apps/preview-two-clients/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@nerima-games/mc-sim": "0.1.25",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@effect/vitest": "^0.30.0",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "oxlint": "^1.76.0",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^3.2.7"
  }
}
